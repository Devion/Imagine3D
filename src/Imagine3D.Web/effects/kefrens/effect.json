{
  "id": "kefrens",
  "name": "Kefrens bars",
  "kind": "scene2d",
  "tags": ["amiga", "retro", "geometric", "minimal", "mechanical", "sparse"],
  "energyRange": [0.1, 0.7],
  "aspects": ["16:9", "9:16"],
  "cost": "low",
  "description": "The single-scanline bar trick: every row shows the same bar at a different point of its sine, leaving a rippling vertical column.",
  "shader": "shader.frag",
  "params": {
    "speed": { "type": "float", "default": "1.8 + 1.0*energy", "min": 0, "max": 6 },
    "lag": { "type": "float", "default": "0.05 + 0.02*bass", "min": 0, "max": 0.3,
             "description": "Phase delay per scanline. Higher makes the column coil more tightly." },
    "width": { "type": "float", "default": "0.055 + 0.02*bass", "min": 0.01, "max": 0.4 },
    "amplitude": { "type": "float", "default": "0.62", "min": 0.1, "max": 1 }
  }
}
