    "steps": { "type": "float", "default": "42.0", "min": 12, "max": 96 },
    "glow": { "type": "float", "default": "0.6 + 0.5*bass + 0.4*brightness", "min": 0, "max": 3 },
    "drift": { "type": "float", "default": "1.6 + 2.2*energy + 0.8*midRel", "min": 0, "max": 8,
              "description": "How fast the camera flies through the bank. 0 hovers, which is what this used to do." }
  }
