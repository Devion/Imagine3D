{
  "id": "kaliset",
  "name": "Kaleidoscopic IFS",
  "kind": "raymarch",
  "tags": ["fractal", "psychedelic", "abstract", "geometric", "cosmic", "high-energy"],
  "energyRange": [0.4, 1.0],
  "coverage": 0.44,
  "aspects": ["16:9", "9:16"],
  "motion": "churn",
  "focus": "centre",
  "cost": "medium",
  "description": "Kali-set folding fractal — infinitely detailed geometric lattice that morphs with the track. Hypnotic and busy; good for peaks.",
  "shader": "shader.frag",
  "params": {
    "fold": { "type": "float", "default": "0.72 + 0.12*sin(t*0.21) + 0.05*bass + 0.04*lowMidRel", "min": 0.3, "max": 1.2 },
    "iterations": { "type": "float", "default": "14.0", "min": 4, "max": 24 },
    "zoom": { "type": "float", "default": "1.0 + 0.20*beatPulse + 0.15*bassHit", "min": 0.2, "max": 4 },
    "spin": { "type": "float", "default": "0.05 + 0.08*brightness", "min": -1, "max": 1 }
  }
}
