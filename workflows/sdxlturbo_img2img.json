{
  "20": {
    "inputs": { "ckpt_name": "sd_xl_turbo_1.0_fp16.safetensors" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load Checkpoint" }
  },
  "28": {
    "inputs": { "image": %IMAGE% },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Image (previous last frame)" }
  },
  "29": {
    "inputs": { "pixels": ["28", 0], "vae": ["20", 2] },
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE Encode" }
  },
  "6": {
    "inputs": { "text": %PROMPT%, "clip": ["20", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Prompt)" }
  },
  "7": {
    "inputs": { "text": %NEGATIVE%, "clip": ["20", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Negative)" }
  },
  "22": {
    "inputs": { "steps": 4, "denoise": %DENOISE%, "model": ["20", 0] },
    "class_type": "SDTurboScheduler",
    "_meta": { "title": "SDTurboScheduler" }
  },
  "14": {
    "inputs": { "sampler_name": "euler_ancestral" },
    "class_type": "KSamplerSelect",
    "_meta": { "title": "KSamplerSelect" }
  },
  "13": {
    "inputs": {
      "add_noise": true,
      "noise_seed": %SEED%,
      "cfg": 1,
      "model": ["20", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "sampler": ["14", 0],
      "sigmas": ["22", 0],
      "latent_image": ["29", 0]
    },
    "class_type": "SamplerCustom",
    "_meta": { "title": "SamplerCustom" }
  },
  "8": {
    "inputs": { "samples": ["13", 0], "vae": ["20", 2] },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "27": {
    "inputs": { "filename_prefix": %OUTPUT_PREFIX%, "images": ["8", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
